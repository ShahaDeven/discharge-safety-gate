# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# Optional overrides
# DSG_AGENT_MODEL=claude-haiku-5-5      # reference agent under test (Sonnet costs ~10x more per call)
# DSG_AGENT_EFFORT=medium
# DSG_SIM_MODEL=claude-haiku-5-5        # patient / caregiver simulator
# DSG_SIM_EFFORT=low
# DSG_MAX_AGENT_TURNS=16                # hard cap on agent turns per call
# DSG_MAX_USD=1.0                       # spending cap per run (override with --max-usd)
# DSG_FALLBACKS=0                       # server-side refusal fallback for the agent; off by default so a
#                                       # fallback model never silently replaces the agent under test
