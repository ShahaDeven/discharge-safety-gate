# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# Optional overrides
# DSG_AGENT_MODEL=claude-haiku-5-5      # reference agent under test (Sonnet costs ~10x more per call)
# DSG_AGENT_EFFORT=medium
# DSG_SIM_MODEL=claude-haiku-5-5        # patient / caregiver simulator
# DSG_SIM_EFFORT=low
# DSG_JUDGE_MODEL=claude-haiku-5-5      # scope / no-therapy judge
# DSG_JUDGE_EFFORT=medium
# DSG_MAX_AGENT_TURNS=16                # hard cap on agent turns per call
# DSG_MAX_USD=1.0                       # spending cap per run (override with --max-usd)
# DSG_FALLBACKS=0                       # server-side refusal fallback for the agent; off by default so a
#                                       # fallback model never silently replaces the agent under test

# Console (python -m web)
# DSG_TOKEN=<any long random string>    # fixed access token; keeps your outside agents yours across restarts
# DSG_READ_ONLY=0                       # 1 = public demo: nothing spends money or changes data
# DSG_LIVE_MAX_USD=0.50                 # spending caps: per server session, per day, per gate run
# DSG_DAY_MAX_USD=2.00
# DSG_RUN_MAX_USD=1.00
# DSG_AGENT_MASTER_KEY=                 # signs requests to outside agents; default: .secrets/agent_master.key
